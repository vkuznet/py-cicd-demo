
Bootstrap: docker
From: debian:bookworm-slim

%labels
    Author       Valentin Kuznetsov
    Application  py-cicd-demo
    Description  Minimal Python demo application with optional dependencies

%files
    hello.py /app/hello.py
    requirements.txt /app/requirements.txt

%post
    export DEBIAN_FRONTEND=noninteractive
    export PIP_NO_CACHE_DIR=1
    export PIP_DISABLE_PIP_VERSION_CHECK=1

    apt-get update
    apt-get install -y --no-install-recommends \
        python3 \
        python3-pip \
        python3-venv

    rm -rf /var/lib/apt/lists/*

    # Create isolated Python environment
    python3 -m venv /opt/venv

    /opt/venv/bin/pip install --upgrade pip

    # Install only explicitly declared dependencies.
    if [ -s /app/requirements.txt ]; then
        /opt/venv/bin/pip install -r /app/requirements.txt
    fi

    # Make application files readable
    chmod -R a+rX /app

%environment
    export PATH="/opt/venv/bin:${PATH}"
    export PYTHONUNBUFFERED=1
    export PYTHONDONTWRITEBYTECODE=1

%runscript
    exec python3 /app/hello.py "$@"
